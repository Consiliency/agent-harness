  "x-cli": {
    "argv": [
      "agent-harness-placement",
      "--client",
      "<agent-harness|agent-toolkit>",
      "<reserve|release|reap|version>"
    ],
    "client_flag": "--client is required and selects exactly one per-client operator configuration, certificate and inventory. agent-toolkit accepts only pi-runner; agent-harness accepts only leg, qualification and implementation. Environment variables never select or override client, configuration, certificate or inventory.",
    "input": "reserve, release and reap read exactly one UTF-8 JSON object from stdin followed by EOF, maximum 65536 bytes; duplicate keys, non-finite numbers, trailing data and invalid UTF-8 refuse before effects. version requires empty stdin.",
    "output": "Exactly one compact UTF-8 JSON response object followed by LF on stdout; stdout carries no other text. version emits VersionResponse before any placement effect.",
    "stderr": "Empty for schema-valid protocol outcomes; bounded closed harness diagnostics only for invocation or internal failures; never input values, credentials, policy documents or exception chains.",
    "exit_codes": {
      "0": "Schema-valid and settled: version response emitted; reserve outcome admitted; release state released; or reap state complete.",
      "10": "Schema-valid and nothing held by this attempt: reserve outcome at_capacity, refused or unreachable; or release state unknown_reservation. Do not allocate a new request_id for a retry of that same reserve attempt.",
      "20": "Schema-valid and an effect may remain: reserve outcome timeout, release state cleanup_pending, or reap state cleanup_pending. Reserve/release barriers key on selected client plus reservation_id, or selected client plus request_id until a reservation_id is known; each reap-pending journal entry keeps its own such key. Retry that request_id or release that reservation. Other reservations, including concurrent reservations for the same client, remain admissible.",
      "70": "Internal or protocol failure. Stdout is absent. Retry the same request_id once. Reap is caller-inventory maintenance, not recovery for one lost reserve response."
    }
  },
