        },
        "ttl_s": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "image_digest": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "policy_vector": {
          "$ref": "#/$defs/PolicyVector"
        },
        "deadline_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 900000,
          "description": "Budget for the whole reserve walk, in milliseconds. The cap is admit_wait_s plus transfer_allowance_s from the pinned driver defaults (600s + 300s). Each coordinator RPC uses a shorter deadline that does not exceed the remaining budget."
        },
        "caller_context": {
          "$ref": "#/$defs/CallerContext"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "workload": {
                "const": "pi-runner"
              }
            },
            "required": ["workload"]
          },
          "then": {
            "properties": {
              "policy_vector": {
                "const": "full-remote-pi-runner"
              }
            }
          }
        }
      ]
    },
    "ReserveResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "request_id",
        "outcome",
        "code",
        "reason",
        "reservation",
        "trail",
        "caller_context"
      ],
      "properties": {
        "schema": {
          "const": "placement.reserve.response.v1"
        },
        "request_id": {
          "$ref": "#/$defs/RequestId"
        },
        "outcome": {
          "$ref": "#/$defs/AdmissionOutcome"
        },
        "code": {
          "oneOf": [
            {
              "$ref": "#/$defs/ResultCode"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "oneOf": [
            {
              "$ref": "#/$defs/AdmissionReason"
            },
            {
              "type": "null"
            }
          ]
        },
        "reservation": {
          "oneOf": [
            {
              "$ref": "#/$defs/Reservation"
            },
            {
              "type": "null"
            }
          ]
        },
        "trail": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/TrailEntry"
          }
        },
        "caller_context": {
          "$ref": "#/$defs/CallerContext"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "admitted"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "properties": {
              "code": {
                "type": "null"
              },
              "reason": {
                "type": "null"
              },
              "reservation": {
                "$ref": "#/$defs/Reservation"
              }
            }
          },
          "else": {
            "properties": {
              "code": {
                "$ref": "#/$defs/ResultCode"
              },
              "reservation": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "ReleaseRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "request_id",
        "reservation",
        "deadline_ms",
        "caller_context"
      ],
      "properties": {
        "schema": {
          "const": "placement.release.request.v1"
        },
        "request_id": {
          "$ref": "#/$defs/RequestId"
        },
        "reservation": {
          "$ref": "#/$defs/Reservation"
        },
        "deadline_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30000
        },
        "caller_context": {
          "$ref": "#/$defs/CallerContext"
        }
      }
    },
    "ReleaseResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "request_id",
        "reservation_id",
        "state",
        "code",
        "flags",
        "caller_context"
      ],
      "properties": {
        "schema": {
          "const": "placement.release.response.v1"
        },
        "request_id": {
          "$ref": "#/$defs/RequestId"
        },
        "reservation_id": {
          "$ref": "#/$defs/OpaqueId"
        },
        "state": {
          "enum": [
            "released",
            "cleanup_pending",
            "unknown_reservation"
          ]
        },
        "code": {
          "oneOf": [
            {
              "$ref": "#/$defs/PlacementCode"
            },
            {
              "type": "null"
            }
          ]
        },
        "flags": {
          "$ref": "#/$defs/LeaseFlags"
        },
        "caller_context": {
          "$ref": "#/$defs/CallerContext"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "released"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "code": {
                "type": "null"
              },
              "flags": {
                "properties": {
                  "cleanup_pending": {
                    "const": false
                  },
                  "barrier_confirmed": {
                    "const": true
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "code": {
                "$ref": "#/$defs/PlacementCode"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "cleanup_pending"
              }
            },
            "required": ["state"]
          },
          "then": {
            "properties": {
              "flags": {
                "properties": {
                  "cleanup_pending": {
                    "const": true
                  },
                  "barrier_confirmed": {
                    "const": false
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "unknown_reservation"
              }
            },
            "required": ["state"]
          },
          "then": {
            "properties": {
              "code": {
                "const": "sandbox_placement_refused"
              },
              "flags": {
                "properties": {
                  "reserved": {
                    "const": false
                  },
                  "cleanup_pending": {
                    "const": false
                  },
                  "barrier_confirmed": {
                    "const": true
                  }
                }
              }
            }
          }
        }
      ]
    },
    "InventoryReapResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "client",
        "inventory",
        "examined",
        "destroyed",
        "pending",
        "code"
      ],
      "properties": {
        "client": {
          "$ref": "#/$defs/Client"
        },
        "inventory": {
          "$ref": "#/$defs/Client"
        },
        "examined": {
          "type": "integer",
          "minimum": 0
        },
        "destroyed": {
          "type": "integer",
          "minimum": 0
        },
        "pending": {
          "type": "integer",
          "minimum": 0
        },
        "code": {
          "oneOf": [
            {
              "$ref": "#/$defs/PlacementCode"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "client": {
                "const": "agent-harness"
              }
            },
            "required": ["client"]
          },
          "then": {
            "properties": {
              "inventory": {
                "const": "agent-harness"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "client": {
                "const": "agent-toolkit"
              }
            },
            "required": ["client"]
          },
          "then": {
            "properties": {
              "inventory": {
                "const": "agent-toolkit"
              }
            }
          }
        }
      ]
    },
    "ReapRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "request_id",
        "scope",
        "deadline_ms",
        "max_items",
        "caller_context"
      ],
      "properties": {
        "schema": {
          "const": "placement.reap.request.v1"
        },
        "request_id": {
          "$ref": "#/$defs/RequestId"
        },
        "scope": {
          "const": "caller_inventory"
        },
        "deadline_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30000
        },
        "max_items": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "caller_context": {
          "$ref": "#/$defs/CallerContext"
        }
      }
    },
    "ReapResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "request_id",
        "state",
        "inventories",
        "caller_context"
      ],
      "properties": {
        "schema": {
          "const": "placement.reap.response.v1"
        },
        "request_id": {
          "$ref": "#/$defs/RequestId"
        },
        "state": {
          "enum": [
            "complete",
            "cleanup_pending"
          ]
        },
        "inventories": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/InventoryReapResult"
          }
        },
        "caller_context": {
          "$ref": "#/$defs/CallerContext"
        }
      }
    },
    "VersionResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "client",
        "protocol_schema_sha256",
        "config_sha256"
      ],
      "properties": {
        "schema": {
          "const": "placement.version.response.v1"
        },
        "client": {
          "$ref": "#/$defs/Client"
        },
        "protocol_schema_sha256": {
          "$ref": "#/$defs/HexSha256"
        },
        "config_sha256": {
          "$ref": "#/$defs/HexSha256"
        }
      }
    }
  }
}
