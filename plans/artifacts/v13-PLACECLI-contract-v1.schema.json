  "x-policy-resolution": {
    "source": "phase-loop-runtime/src/phase_loop_runtime/contracts/placement/vectors/policies.json",
    "accepted_names_at_this_version": [
      "minimal-with-app",
      "minimal-without-app",
      "full-remote-pi-runner"
    ],
    "rule": "policy_vector is a name, never an inline policy. The CLI resolves exactly one valid vector, verifies its recorded digest and refuses an unknown, refused or non-qualified vector before admission. Adding or renaming a vector requires a new protocol artifact version."
  },
  "x-identity-inventories": [
