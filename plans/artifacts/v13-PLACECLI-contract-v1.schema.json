{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Consiliency/agent-harness/plans/artifacts/v13-PLACECLI-contract-v1.schema.json",
  "title": "agent-harness placement process protocol v1",
  "description": "Frozen JSON-in/JSON-out process contract for placement reserve, release and reap. This planning artifact is not a live activation record.",
  "oneOf": [
    {
      "$ref": "#/$defs/ReserveRequest"
    },
    {
      "$ref": "#/$defs/ReserveResponse"
    },
    {
      "$ref": "#/$defs/ReleaseRequest"
    },
    {
      "$ref": "#/$defs/ReleaseResponse"
    },
    {
      "$ref": "#/$defs/ReapRequest"
    },
    {
      "$ref": "#/$defs/ReapResponse"
    }
  ],
  "x-cli": {
    "argv": [
      "python",
      "-I",
      "-m",
      "phase_loop_runtime.placement_cli",
      "<reserve|release|reap>"
    ],
    "input": "Exactly one UTF-8 JSON object on stdin, followed by EOF; maximum 65536 bytes; duplicate keys, non-finite numbers, trailing data and invalid UTF-8 refuse before effects.",
    "output": "Exactly one compact UTF-8 JSON response object followed by LF on stdout; stdout carries no other text.",
    "stderr": "Empty for schema-valid protocol outcomes; bounded closed harness diagnostics only for invocation or internal failures; never input values, credentials, policy documents or exception chains.",
    "exit_codes": {
      "0": "A schema-valid definitive response; inspect the response outcome or state.",
      "10": "Refused with nothing held; stdout is a schema-valid response.",
      "20": "Uncertain cleanup; stdout is a schema-valid response and the caller must release or reap before another admission.",
      "70": "Internal or protocol failure; stdout is absent or must not be trusted. The caller must reap if an effect may have started."
    }
  },
