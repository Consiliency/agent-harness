  "x-local-headroom-defaults": {
    "memory_available_bytes_minimum": 1073741824,
    "load_per_cpu_percent_maximum_exclusive": 100,
    "live_sandboxes_maximum_exclusive": 4,
    "observation_age_seconds_maximum": 5,
    "unknown_or_stale_dimension": "at_capacity",
    "source": "phase-loop-runtime/src/phase_loop_runtime/advisor_board/fixtures/placement-driver.defaults.toml"
  },
  "x-placement-semantics": {
    "trusted_configuration": "The request contains no owner, client, target, target list, certificate selector, inline policy or fallback list. Those values come from operator-owned configuration bound by config_sha256.",
    "agent_and_executor_order": [
      "ai by authoritative capacity",
      "local only when every published headroom threshold admits",
      "e2b only after a later owner account-and-spend activation"
    ],
    "review_seat_order": "Consume the landed SEATS JAILCORE route-policy outcome. On owned hosts, remote capacity use additionally requires the generic egress and credential probes. Per-vendor OD-7 applies only to third-party clouds.",
    "before_admission": "reserve may make a fresh admission attempt at each ranked target and records every attempt in trail. A typed at_capacity result authorizes only a new admission attempt.",
    "after_admission": "The reservation binds exactly one target and transport_id. The admitted launch envelope must name that transport_id. No route, transport, executable, environment, policy or deadline fallback is allowed after admission; a change requires a new envelope and a new reserve request_id.",
    "uncertain_cleanup": "A bare failure after a request may have taken effect blocks every later target until release or reap confirms the barrier.",
    "caller_context": "Opaque metadata echoed exactly and never used for identity, authority, routing, policy, correlation or launch input. It must contain no secret value or secret-derived digest.",
    "remote_writer_tier": "provider_readonly_patch_return_audit",
    "e2b": "Represented but disabled until ai is live and the owner supplies an account and spend cap."
  },
  "x-cross-process-vocabulary": {
    "placement": "Reserve trails and terminal placement results use AdmissionOutcome, AdmissionReason, CoordinatorErrorCode and PlacementCode only.",
    "admission": "supervised_worker_cli admission uses AdmissionDiagnostic only; placement does not relabel admission failures.",
    "run": "Run status uses RunState and Termination. sandbox_placement_lost_after_launch and sandbox_placement_release_unconfirmed are attempt-evidence codes, not invented run states."
  },
  "$defs": {
    "Sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "HexSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "RequestId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "OpaqueId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "CallerContext": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "maxLength": 512
          },
          {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "Workload": {
      "enum": [
        "leg",
        "qualification",
        "implementation",
        "pi-runner"
      ]
    },
    "PolicyVector": {
      "enum": [
        "minimal-with-app",
        "minimal-without-app",
        "full-remote-pi-runner"
      ]
    },
    "Client": {
      "enum": [
        "agent-harness",
        "agent-toolkit"
      ]
    },
    "TargetKind": {
      "enum": [
        "local",
        "openshell",
        "e2b"
      ]
    },
    "AdmissionOutcome": {
      "enum": [
        "admitted",
        "at_capacity",
        "refused",
        "unreachable",
        "timeout"
      ]
    },
    "AdmissionReason": {
      "enum": [
        "no_capacity",
        "pressure",
        "fairness_wait",
        "reserved_for_other_client",
        "recovering",
        "telemetry_stale",
        "slice_unbounded",
        "untracked_vms",
        "ledger_restored",
        "internal"
      ]
    },
    "CoordinatorErrorCode": {
      "enum": [
        "at_capacity",
        "owner_mismatch",
        "not_enrolled",
        "unknown_lease",
        "fenced",
        "expired",
        "lifetime_exceeded",
        "digest_mismatch",
        "duplicate_binding",
        "snapshot_expired",
        "invalid_request",
        "workload_unsupported",
        "deadline_exceeded",
        "unavailable"
      ]
    },
    "PlacementCode": {
      "enum": [
        "sandbox_placement_required_unavailable",
        "sandbox_placement_driver_unavailable",
        "sandbox_placement_ref_invalid",
        "sandbox_placement_capability_undeclared",
        "sandbox_placement_plugin_unavailable",
        "sandbox_placement_backend_unregistered",
        "sandbox_placement_unreachable",
        "sandbox_placement_budget_spent",
        "sandbox_placement_at_capacity",
        "sandbox_placement_capacity_exhausted",
        "sandbox_placement_refused",
        "sandbox_placement_code_invalid",
        "sandbox_placement_operation_timeout",
        "sandbox_placement_capability_unmet",
        "sandbox_placement_release_unconfirmed",
        "sandbox_placement_local_release_unconfirmed",
        "sandbox_placement_not_enrolled",
        "sandbox_placement_identity_mismatch",
        "sandbox_placement_workload_unsupported",
        "sandbox_placement_lost_after_launch",
        "sandbox_placement_end_reached"
      ]
    },
    "ResultCode": {
      "oneOf": [
        {
          "$ref": "#/$defs/CoordinatorErrorCode"
        },
        {
          "$ref": "#/$defs/PlacementCode"
        }
      ]
    },
    "AdmissionDiagnostic": {
      "enum": [
        "envelope_schema_invalid",
        "envelope_digest_mismatch",
        "authority_foreign",
        "authority_baseline_stale",
        "locator_not_repo_relative",
        "raw_output_in_record",
        "dependency_digest_required",
        "workspace_source_inconsistent",
        "executable_chain_invalid",
        "baseline_reference_required",
        "target_map_outside_scope",
        "tier_unqualified",
        "route_not_qualified",
        "constraint_unsupported",
        "workspace_not_separate_copy",
        "grant_unqualified",
        "stop_policy_unbounded",
        "timeout_over_declared_max",
        "launch_instructions_mismatch",
        "launch_reference_mismatch",
        "launch_argv_mismatch",
        "launch_executable_mismatch",
        "launch_workspace_mismatch",
        "launch_environment_mismatch",
        "launch_policy_mismatch",
        "launch_timeout_mismatch",
        "launch_input_unbound",
        "task_unbound",
        "dependency_route_unwired",
        "codec_unavailable"
      ]
    },
    "RunState": {
      "enum": [
        "finished",
        "refused"
      ]
    },
    "Termination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "signal",
        "by"
      ],
      "properties": {
        "reason": {
          "enum": [
            "completed",
            "cancelled",
            "timed_out",
            "failed_to_start"
          ]
        },
        "signal": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 32
        },
        "by": {
          "enum": [
            "worker",
            "harness",
            "operator"
          ]
        }
      }
    },
    "PlacementTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "rank"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/OpaqueId"
        },
        "kind": {
          "$ref": "#/$defs/TargetKind"
        },
        "rank": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        }
      }
    },
    "TrailEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "outcome",
        "code",
        "reason"
      ],
      "properties": {
        "target": {
          "$ref": "#/$defs/OpaqueId"
        },
        "outcome": {
          "$ref": "#/$defs/AdmissionOutcome"
        },
        "code": {
          "oneOf": [
            {
              "$ref": "#/$defs/ResultCode"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "oneOf": [
            {
              "$ref": "#/$defs/AdmissionReason"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "LeaseFlags": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reserved",
        "create_settled",
        "ready",
        "exec_claimed",
        "fenced",
        "destruction_observed",
        "cleanup_pending",
        "barrier_confirmed",
        "expired"
      ],
      "properties": {
        "reserved": {
          "type": "boolean"
        },
        "create_settled": {
          "type": "boolean"
        },
        "ready": {
          "type": "boolean"
        },
        "exec_claimed": {
          "type": "boolean"
        },
        "fenced": {
          "type": "boolean"
        },
        "destruction_observed": {
          "type": "boolean"
        },
        "cleanup_pending": {
          "type": "boolean"
        },
        "barrier_confirmed": {
          "type": "boolean"
        },
        "expired": {
          "type": "boolean"
        }
      }
    },
    "ForwardTcpUnixBridge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "service_name",
        "socket_path",
        "directory_mode",
        "socket_mode",
        "lifetime"
      ],
      "properties": {
        "kind": {
          "const": "forward_tcp_unix"
        },
        "service_name": {
          "$ref": "#/$defs/OpaqueId"
        },
        "socket_path": {
          "type": "string",
          "pattern": "^/[^\\u0000\\r\\n]{1,4095}$"
        },
        "directory_mode": {
          "const": "0700"
        },
        "socket_mode": {
          "const": "0600"
        },
        "lifetime": {
          "const": "reservation"
        }
      }
    },
    "Reservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "reservation_id",
        "workload",
        "target",
        "transport_id",
        "image_digest",
        "policy_vector",
        "policy_digest",
        "client",
        "inventory",
        "lease_id",
        "expires_at",
        "config_sha256",
        "bridge"
      ],
      "properties": {
        "schema": {
          "const": "placement.reservation.v1"
        },
        "reservation_id": {
          "$ref": "#/$defs/OpaqueId"
        },
        "workload": {
          "$ref": "#/$defs/Workload"
        },
        "target": {
          "$ref": "#/$defs/PlacementTarget"
        },
        "transport_id": {
          "$ref": "#/$defs/OpaqueId"
        },
        "image_digest": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "policy_vector": {
          "$ref": "#/$defs/PolicyVector"
        },
        "policy_digest": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "client": {
          "$ref": "#/$defs/Client"
        },
        "inventory": {
          "$ref": "#/$defs/Client"
        },
        "lease_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/OpaqueId"
            },
            {
              "type": "null"
            }
          ]
        },
        "expires_at": {
          "oneOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "config_sha256": {
          "$ref": "#/$defs/HexSha256"
        },
        "bridge": {
          "oneOf": [
            {
              "$ref": "#/$defs/ForwardTcpUnixBridge"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "workload": {
                "const": "pi-runner"
              },
              "target": {
                "properties": {
                  "kind": {
                    "const": "openshell"
                  }
                }
              }
            },
            "required": [
              "workload",
              "target"
            ]
          },
          "then": {
            "properties": {
              "client": {
                "const": "agent-toolkit"
              },
              "inventory": {
                "const": "agent-toolkit"
              },
              "bridge": {
                "$ref": "#/$defs/ForwardTcpUnixBridge"
              }
            }
          }
        }
      ]
    },
    "ReserveRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "request_id",
        "workload",
        "ttl_s",
        "image_digest",
        "policy_vector",
        "deadline_ms",
        "caller_context"
      ],
      "properties": {
        "schema": {
          "const": "placement.reserve.request.v1"
        },
        "request_id": {
          "$ref": "#/$defs/RequestId"
        },
        "workload": {
          "$ref": "#/$defs/Workload"
        },
        "ttl_s": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "image_digest": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "policy_vector": {
          "$ref": "#/$defs/PolicyVector"
        },
        "deadline_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30000
        },
        "caller_context": {
          "$ref": "#/$defs/CallerContext"
        }
      }
    },
    "ReserveResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "request_id",
        "outcome",
        "code",
        "reason",
        "reservation",
        "trail",
        "caller_context"
      ],
      "properties": {
        "schema": {
          "const": "placement.reserve.response.v1"
        },
        "request_id": {
          "$ref": "#/$defs/RequestId"
        },
        "outcome": {
          "$ref": "#/$defs/AdmissionOutcome"
        },
        "code": {
          "oneOf": [
            {
              "$ref": "#/$defs/ResultCode"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "oneOf": [
            {
              "$ref": "#/$defs/AdmissionReason"
            },
            {
              "type": "null"
            }
          ]
        },
        "reservation": {
          "oneOf": [
            {
              "$ref": "#/$defs/Reservation"
            },
            {
              "type": "null"
            }
          ]
        },
        "trail": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/TrailEntry"
          }
        },
        "caller_context": {
          "$ref": "#/$defs/CallerContext"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "admitted"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "properties": {
              "code": {
                "type": "null"
              },
              "reason": {
                "type": "null"
              },
              "reservation": {
                "$ref": "#/$defs/Reservation"
              }
            }
          },
          "else": {
            "properties": {
              "code": {
                "$ref": "#/$defs/ResultCode"
              },
              "reservation": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "ReleaseRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "request_id",
        "reservation",
        "deadline_ms",
        "caller_context"
      ],
      "properties": {
        "schema": {
          "const": "placement.release.request.v1"
        },
        "request_id": {
          "$ref": "#/$defs/RequestId"
        },
        "reservation": {
          "$ref": "#/$defs/Reservation"
        },
        "deadline_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30000
        },
        "caller_context": {
          "$ref": "#/$defs/CallerContext"
        }
      }
    },
    "ReleaseResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "request_id",
        "reservation_id",
        "state",
        "code",
        "flags",
        "caller_context"
      ],
      "properties": {
        "schema": {
          "const": "placement.release.response.v1"
        },
        "request_id": {
          "$ref": "#/$defs/RequestId"
        },
        "reservation_id": {
          "$ref": "#/$defs/OpaqueId"
        },
        "state": {
          "enum": [
            "released",
            "cleanup_pending",
            "unknown_reservation"
          ]
        },
        "code": {
          "oneOf": [
            {
              "$ref": "#/$defs/PlacementCode"
            },
            {
              "type": "null"
            }
          ]
        },
        "flags": {
          "$ref": "#/$defs/LeaseFlags"
        },
        "caller_context": {
          "$ref": "#/$defs/CallerContext"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "released"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "code": {
                "type": "null"
              },
              "flags": {
                "properties": {
                  "cleanup_pending": {
                    "const": false
                  },
                  "barrier_confirmed": {
                    "const": true
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "code": {
                "$ref": "#/$defs/PlacementCode"
              }
            }
          }
        }
      ]
    },
    "InventoryReapResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "client",
        "inventory",
        "examined",
        "destroyed",
        "pending",
        "code"
      ],
      "properties": {
        "client": {
          "$ref": "#/$defs/Client"
        },
        "inventory": {
          "$ref": "#/$defs/Client"
        },
        "examined": {
          "type": "integer",
          "minimum": 0
        },
        "destroyed": {
          "type": "integer",
          "minimum": 0
        },
        "pending": {
          "type": "integer",
          "minimum": 0
        },
        "code": {
          "oneOf": [
            {
              "$ref": "#/$defs/PlacementCode"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ReapRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "request_id",
        "scope",
        "deadline_ms",
        "max_items",
        "caller_context"
      ],
      "properties": {
        "schema": {
          "const": "placement.reap.request.v1"
        },
        "request_id": {
          "$ref": "#/$defs/RequestId"
        },
        "scope": {
          "const": "configured_inventories"
        },
        "deadline_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30000
        },
        "max_items": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "caller_context": {
          "$ref": "#/$defs/CallerContext"
        }
      }
    },
    "ReapResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "request_id",
        "state",
        "inventories",
        "caller_context"
      ],
      "properties": {
        "schema": {
          "const": "placement.reap.response.v1"
        },
        "request_id": {
          "$ref": "#/$defs/RequestId"
        },
        "state": {
          "enum": [
            "complete",
            "cleanup_pending"
          ]
        },
        "inventories": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/InventoryReapResult"
          }
        },
        "caller_context": {
          "$ref": "#/$defs/CallerContext"
        }
      }
    }
  }
}
