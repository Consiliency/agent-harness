# Source recipe only. Build context is this directory; payload is a named context
# produced by prepare.py. No host homes, wrapper scripts or credentials are copied.
FROM --platform=linux/amd64 docker.io/library/python@sha256:623674a14ef93d052bb9b0de4dbf5f28eb578a35263838941cc8aa43213c1487
COPY --from=payload --chown=0:0 / /opt/advisors/
COPY --chown=0:0 payload.lock.json check.py /usr/share/advisor-workload/
RUN echo '3016e62cb4b7cd8038822870601f5ed131befe942774d0f745622cc77d8a88f7  /opt/advisors/dependencies/libgcc-s1_12.2.0-14+deb12u1_amd64.deb' | sha256sum -c - \
    && echo '5cd3171216d4ab0fc911cfe9c35509bf2dd8f47761c43b7f6a4296701551a24d  /opt/advisors/dependencies/libstdc++6_12.2.0-14+deb12u1_amd64.deb' | sha256sum -c - \
    && dpkg-deb -x /opt/advisors/dependencies/libgcc-s1_12.2.0-14+deb12u1_amd64.deb / \
    && dpkg-deb -x /opt/advisors/dependencies/libstdc++6_12.2.0-14+deb12u1_amd64.deb /
RUN groupadd --gid 10001 sandbox \
    && useradd --uid 10001 --gid 10001 --home-dir /home/sandbox --create-home sandbox \
    && install -d -o 10001 -g 10001 -m 0700 /work \
    && chmod 0700 /home/sandbox \
    && chmod -R a+rX,go-w /opt/advisors \
    && ln -s /opt/advisors/bin/claude /usr/local/bin/claude \
    && ln -s /opt/advisors/bin/agy /usr/local/bin/agy \
    && ln -s /opt/advisors/bin/grok /usr/local/bin/grok \
    && ln -s /opt/advisors/bin/node /usr/local/bin/node \
    && ln -s /opt/advisors/codex/bin/codex /usr/local/bin/codex \
    && ln -s /opt/advisors/codex/codex-path/rg /usr/local/bin/rg
ENV HOME=/home/sandbox
ENV PATH=/opt/advisors/codex/codex-path:/usr/local/bin:/usr/bin:/bin
ENV DISABLE_AUTOUPDATER=1
USER 10001:10001
WORKDIR /work
# All bundled native modules are inspected, including optional Codex resources.
# Missing libraries stop the build; a host ldd result cannot qualify this image.
RUN ["/usr/local/bin/python3", "-I", "/usr/share/advisor-workload/check.py"]
CMD ["/usr/local/bin/python3", "-I", "/usr/share/advisor-workload/check.py"]
