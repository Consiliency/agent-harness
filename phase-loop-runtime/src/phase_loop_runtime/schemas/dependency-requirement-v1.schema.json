{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-harness.example/dependency-requirement-v1.schema.json",
  "title": "Trusted executable dependency requirement v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "mode",
    "provider",
    "selected_executable",
    "authority_id",
    "expected_authority_sha256",
    "adapter",
    "policy",
    "base_profile_sha256"
  ],
  "properties": {
    "schema": {
      "const": "org.agent-harness.dependency-requirement.v1"
    },
    "mode": {
      "const": "required"
    },
    "provider": {
      "$ref": "#/$defs/name"
    },
    "selected_executable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "mode", "size", "sha256"],
      "properties": {
        "path": {
          "$ref": "#/$defs/absolutePath"
        },
        "kind": {
          "const": "file"
        },
        "mode": {
          "$ref": "#/$defs/mode"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 536870912
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "authority_id": {
      "$ref": "#/$defs/sha256"
    },
    "expected_authority_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "adapter": {
      "$ref": "#/$defs/adapter"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {
          "$ref": "#/$defs/name"
        },
        "version": {
          "$ref": "#/$defs/name"
        }
      }
    },
    "base_profile_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
    },
    "absolutePath": {
      "type": "string",
      "minLength": 2,
      "maxLength": 4096,
      "pattern": "^/[ -~]+$"
    },
    "mode": {
      "type": "string",
      "pattern": "^0[0-7]{3}$"
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {
          "$ref": "#/$defs/name"
        },
        "version": {
          "$ref": "#/$defs/name"
        }
      }
    }
  }
}

